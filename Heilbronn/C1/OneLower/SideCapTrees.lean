/-! # The side cap cover: all cases (generated by `scripts/c1_one_lower/hex.py`)

The 153 word cases, collected from the chunks, with the kernel-checked trees. -/

@[expose] public section

namespace Heilbronn.C1OneLowerHex.TreesSideCap

open Cover C1OneLowerHex.Model

/-- All the cases with their trees. -/
noncomputable def allCases : List ((ℕ × ℕ × ℕ) × Cover.Tree C1ZeroLower.Model.Split) :=
  chunk0 ++ chunk1 ++ chunk2

theorem allCases_ok : ∀ p ∈ allCases,
    checkTree (spec true p.1.1 p.1.2.1 p.1.2.2) [] p.2 = true := by
  intro p hp
  simp only [allCases, List.mem_append, or_assoc] at hp
  rcases hp with hp | hp | hp
  exacts [chunk0_ok p hp, chunk1_ok p hp, chunk2_ok p hp]

