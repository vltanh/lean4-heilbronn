/-! # Opposite-cap cover, part 3 (generated by `scripts/six_opposite_cap/export.py`)

The two height certificates `left` (`e_x ≤ c`) and `low` (`g_y ≤ h`) of the sharp word, on its atoms. -/

@[expose] public section

namespace Heilbronn.SixBoundaryOppositeCapCompletion.Trees

open Cert Cert.Expr Cover Model

/-- The facts of the sharp word `(4, 3, 3, 2, 3, 4, 5, 4)` along the cover. -/
def sharpFacts : List SFact :=
  (((((((([] ++ branchFacts 4 3) ++ branchFacts 5 4) ++ branchFacts 0 4) ++ branchFacts 1 3) ++ branchFacts 2 3) ++ branchFacts 3 2) ++ branchFacts 6 5) ++ branchFacts 7 4)

/-- The `left` certificate (264 terms): the atoms of the sharp word and the branch factor `c - e_x`. -/
theorem left_ok : Cert.check (atoms sharpFacts ++ [v 3 - v 6])
    (term_rows% "../../../data/six_opposite_cap/w43323454_left.txt") = true := by
  decide +kernel

/-- The `low` certificate (265 terms): the atoms of the sharp word and the branch factor `h - g_y`. -/
theorem low_ok : Cert.check (atoms sharpFacts ++ [v 1 - v 9])
    (term_rows% "../../../data/six_opposite_cap/w43323454_low.txt") = true := by
  decide +kernel

end Heilbronn.SixBoundaryOppositeCapCompletion.Trees
