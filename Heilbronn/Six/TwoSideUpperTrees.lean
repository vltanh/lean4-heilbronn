module

public import Heilbronn.Six.TwoSideUpperTrees.Chunk0
public import Heilbronn.Six.TwoSideUpperTrees.Chunk1
public import Heilbronn.Six.TwoSideUpperTrees.Chunk2
public import Heilbronn.Six.TwoSideUpperTrees.Chunk3
public import Heilbronn.Six.TwoSideUpperTrees.Chunk4
public import Heilbronn.Six.TwoSideUpperTrees.Chunk5
public import Heilbronn.Six.TwoSideUpperTrees.Chunk6

/-! # Two-side-upper cover: the root check (generated by `scripts/six_two_side_upper/export.py`)

The word cover of `Q`, split first at `V_7`, then at `V_2`; its depth-two subtrees are checked in the chunks. -/

@[expose] public section

namespace Heilbronn.SixBoundaryTwoSideUpper.Trees

open Cover Model

/-- The complete word cover. -/
noncomputable def tree : Cover.Tree Split :=
  .node (.vertex 7) [.node (.vertex 2) [sub_3_2, sub_3_3, sub_3_4],
    .node (.vertex 2) [sub_4_2, sub_4_3, sub_4_4],
    .node (.vertex 2) [sub_5_2, sub_5_3, sub_5_4]]

theorem branches_root : branches [] (.vertex 7) = [branchFacts 7 3, branchFacts 7 4, branchFacts 7 5] := by decide +kernel

theorem branches_3 : branches ([] ++ branchFacts 7 3) (.vertex 2) = [branchFacts 2 2, branchFacts 2 3, branchFacts 2 4] := by
  decide +kernel

theorem branches_4 : branches ([] ++ branchFacts 7 4) (.vertex 2) = [branchFacts 2 2, branchFacts 2 3, branchFacts 2 4] := by
  decide +kernel

theorem branches_5 : branches ([] ++ branchFacts 7 5) (.vertex 2) = [branchFacts 2 2, branchFacts 2 3, branchFacts 2 4] := by
  decide +kernel

theorem tree_ok : checkTree spec [] tree = true := by
  rw [tree, checkTree_node, show spec.branches = branches from rfl, branches_root]
  simp only [checkChildren_cons, checkChildren_nil, Bool.and_true, Bool.and_eq_true]
  refine ⟨?_, ?_, ?_⟩
  · rw [checkTree_node, show spec.branches = branches from rfl, branches_3]
    simp only [checkChildren_cons, checkChildren_nil, Bool.and_true, Bool.and_eq_true]
    exact ⟨sub_3_2_ok, sub_3_3_ok, sub_3_4_ok⟩
  · rw [checkTree_node, show spec.branches = branches from rfl, branches_4]
    simp only [checkChildren_cons, checkChildren_nil, Bool.and_true, Bool.and_eq_true]
    exact ⟨sub_4_2_ok, sub_4_3_ok, sub_4_4_ok⟩
  · rw [checkTree_node, show spec.branches = branches from rfl, branches_5]
    simp only [checkChildren_cons, checkChildren_nil, Bool.and_true, Bool.and_eq_true]
    exact ⟨sub_5_2_ok, sub_5_3_ok, sub_5_4_ok⟩

end Heilbronn.SixBoundaryTwoSideUpper.Trees
