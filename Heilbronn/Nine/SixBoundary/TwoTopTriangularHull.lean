theorem Hull.t246 (H : Hull a h b c d f xx xy) :
    0 ≤ sarea (c, 0) (xx, xy) (0, h) := by
  simp only [sarea]
  rcases le_total xy h with hs | hs
  · replace hs : 0 ≤ h - xy := sub_nonneg.2 hs
    linarith [H.hDXF, mul_nonneg H.ha H.hb, mul_nonneg H.ha H.hfb, mul_nonneg H.ha H.hxf, mul_nonneg H.hh1 H.hx1, mul_nonneg H.hb H.hda, mul_nonneg H.hb H.hxd, mul_nonneg H.hc1 hs, mul_nonneg H.hda H.hfb, mul_nonneg H.hda H.hxf, mul_nonneg H.hfb H.hxd]
  · replace hs : 0 ≤ xy - h := sub_nonneg.2 hs
    linarith [mul_nonneg H.ha H.hb, mul_nonneg H.ha H.hfb, mul_nonneg H.ha H.hxf, mul_nonneg H.hha H.hfb, mul_nonneg H.hha H.hxf, mul_nonneg H.hb H.hda, mul_nonneg H.hb H.hxd, mul_nonneg H.hcb hs]

