/-! # The hull heptagon `A, B, C, D, X, F, H` of `SIX_BOUNDARY_TWO_TOP_TRIANGULAR` (3)

Generated by `scripts/nine/six_radial/hull.py`: the hull triangles are nonnegative linear
combinations of products of the sign data `Hull` (linarith hints found by linear programming); the
least area makes them strictly positive. -/

@[expose] public section

namespace Heilbronn.Nine.SixBoundaryTwoTopTriangular

open SixRadial SixBoundary

/-- The sign data of the hull. -/
structure Hull (a h b c d f xx xy : ℝ) : Prop where
  ha : 0 ≤ a
  hha : 0 ≤ -a + h
  hh1 : 0 ≤ 1 - h
  hb : 0 ≤ b
  hcb : 0 ≤ -b + c
  hc1 : 0 ≤ 1 - c
  hda : 0 ≤ -a + d
  hhd : 0 ≤ -d + h
  hfb : 0 ≤ -b + f
  hcf : 0 ≤ c - f
  hxf : 0 ≤ -f + xx
  hx1 : 0 ≤ 1 - xx
  hxd : 0 ≤ -d + xy
  hxy1 : 0 ≤ 1 - xy
  hDXF : 0 ≤ (1 - d)*(-f + xx) - (1 - f)*(1 - xy)

/-- The hull polygon. -/
def heptV (a h b c d f xx xy : ℝ) : Fin 7 → Point :=
  ![(0, a), (b, 0), (c, 0), (1, d), (xx, xy), (f, 1), (0, h)]

variable {a h b c d f xx xy : ℝ}

theorem Hull.t012 (H : Hull a h b c d f xx xy) :
    0 ≤ sarea (0, a) (b, 0) (c, 0) := by
  simp only [sarea]
  linarith [mul_nonneg H.ha H.hcb]

theorem Hull.t013 (H : Hull a h b c d f xx xy) :
    0 ≤ sarea (0, a) (b, 0) (1, d) := by
  simp only [sarea]
  linarith [H.ha, mul_nonneg H.hb H.hda]

