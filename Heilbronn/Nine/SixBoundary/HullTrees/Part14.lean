noncomputable def root : Cover.Tree Split :=
  .node (.vertex 6 5) [root_0, root_1]

theorem root_br : branches [] (.vertex 6 5) = [branchFacts 6 5 1, branchFacts 6 5 2] := by decide +kernel

theorem root_ok : checkTree spec [] root = true := by
  rw [root, checkTree_node, show spec.branches = branches from rfl, root_br]
  simp only [checkChildren_cons, checkChildren_nil, Bool.and_true, Bool.and_eq_true]
  exact ⟨root_0_ok, root_1_ok⟩

end Heilbronn.Nine.SixBoundaryHull.Trees
