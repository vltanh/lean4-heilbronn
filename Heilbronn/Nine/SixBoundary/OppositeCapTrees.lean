/-! # Opposite-cap cover: the root check (generated by `scripts/nine/six_opposite_cap/export.py`)

The word cover of `O` (2604 certificate terms), split first at `V_4`; the subtrees and the two height certificates are checked in the parts. -/

@[expose] public section

namespace Heilbronn.Nine.SixBoundaryOppositeCapCompletion.Trees

open Cert Cert.Expr Cover Model

/-- The complete word cover. -/
noncomputable def tree : Cover.Tree Split :=
  .node (.vertex 4) [sub_2, sub_3, sub_4, sub_5, sub_6]

theorem branches_root : branches [] (.vertex 4) = [branchFacts 4 2, branchFacts 4 3, branchFacts 4 4, branchFacts 4 5, branchFacts 4 6] := by decide +kernel

theorem tree_ok : checkTree spec [] tree = true := by
  rw [tree, checkTree_node, show spec.branches = branches from rfl, branches_root]
  simp only [checkChildren_cons, checkChildren_nil, Bool.and_true, Bool.and_eq_true]
  exact ⟨sub_2_ok, sub_3_ok, sub_4_ok, sub_5_ok, sub_6_ok⟩

end Heilbronn.Nine.SixBoundaryOppositeCapCompletion.Trees
