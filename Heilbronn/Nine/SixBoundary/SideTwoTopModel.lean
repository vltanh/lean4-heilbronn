/-! # The certificate model of the side/two-top package (`docs/proof/nine/SIX_BOUNDARY_SIDE_TWO_TOP.md`)

Generated by `scripts/nine/six_side_two_top/export.py` from
`docs/proof/nine/six_boundary_side_two_top_certificates.json` (checker
`docs/proof/nine/check_six_boundary_side_two_top.py`), in the generic form `Heilbronn.Nine.SixRadial`:

* points `0, …, 8` are `A, B, C, X, D, E, F, H, O` (the hull octagon and the inner cap point);
  variables `0, …, 11` are `a, h, b, c, d, f, x, y, e_x, e_y, o_x, o_y`;
* `factors`: the 27 affine factors (13); `base`: the 56 hull triangles and `[DFO] < 0`;
  `extra`: the cost `δ - 3s`;
* `enumTree`: the radial words of `O` (split on its entries, leaves closed by the six words);
* `tree i`: the certificate of the word `words[i]` (kernel-checked, one per theorem).
-/

@[expose] public section

namespace Heilbronn.Nine.SixBoundarySideTwoTop.Model

open Cert Cert.Expr Cover SixRadial

/-- The nine points as expressions. -/
def pt : ℕ → Expr × Expr
  | 0 => (0, v 0)
  | 1 => (v 2, 0)
  | 2 => (v 3, 0)
  | 3 => (v 6, v 7)
  | 4 => (1, v 4)
  | 5 => (v 8, v 9)
  | 6 => (v 5, 1)
  | 7 => (0, v 1)
  | 8 => (v 10, v 11)
  | _ => (0, 0)

/-- The 27 affine factors (13). -/
def factors : List Expr :=
  [v 0 - k (1 / 7),
    v 2 - k (1 / 8),
    v 1 - k (1 / 2),
    v 3 - k (32 / 73),
    1 - v 1,
    k (65 / 73) - v 3,
    v 4 - v 0,
    v 1 - v 4,
    v 5 - v 2,
    v 3 - v 5,
    v 4 - k (1 / 2),
    k (5 / 8) - v 4,
    v 1 - v 0 - k (8 / 73),
    v 3 - v 2 - k (8 / 73),
    v 6 - v 3 - k (8 / 73),
    1 - v 6,
    v 7 - k (1 / 7),
    v 4 - v 7 - k (7 / 36),
    k (25 / 73) - v 5,
    v 8 - v 5 - k (48 / 73),
    v 9 - v 4 - k (24 / 73),
    1 - v 8,
    1 - v 9,
    v 10 - v 5 - k (16 / 73),
    v 11 - v 4 - k (1 / 8),
    k (65 / 73) - v 10,
    k (65 / 73) - v 11]

/-- The hull triangles (positive) and `[DFO] < 0`. -/
def base : List SFact := (lexTriples 8).map (fun t => (t, true)) ++ [((4, 6, 8), false)]

/-- The occupancy bounds `s`, `3s`. -/
def bnd (m : ℕ) : ℚ := if m = 0 then 8 / 73 else 24 / 73

/-- The cost `δ - 3s`. -/
def extra (_ : List SFact) : List Expr := [(1 - v 4) * (1 - v 5) - k (24 / 73)]

/-- The package. -/
def pkg : Pkg := ⟨8, 9, pt, factors, base, bnd, [8], extra⟩

/-- The six words (16). -/
def words : List (List ℕ) :=
  [[4, 3, 2, 1, 1, 6, 6, 5],
    [4, 3, 2, 2, 1, 5, 6, 5],
    [4, 3, 3, 2, 1, 4, 6, 5],
    [4, 4, 3, 2, 1, 3, 6, 5],
    [5, 4, 3, 2, 1, 1, 6, 6],
    [5, 4, 3, 2, 1, 2, 6, 5]]

/-- The enumeration of the words of `O`. -/
def enumTree : Cover.Tree Split :=
  .node (.vertex 8 4) [.node (.vertex 8 6) [.node (.vertex 8 0) [.node (.vertex 8 1) [.node (.vertex 8 5) [.node (.vertex 8 2) [.node (.vertex 8 3) [.node (.vertex 8 7) [.closed 2]]], .node (.vertex 8 2) [.node (.vertex 8 3) [.node (.vertex 8 7) [.closed 1]]], .node (.vertex 8 2) [.node (.vertex 8 3) [.node (.vertex 8 7) [.closed 0]]]], .node (.vertex 8 5) [.node (.vertex 8 2) [.node (.vertex 8 3) [.node (.vertex 8 7) [.closed 3]]]]], .node (.vertex 8 1) [.node (.vertex 8 5) [], .node (.vertex 8 5) [.node (.vertex 8 2) [.node (.vertex 8 3) [.node (.vertex 8 7) [.closed 4]]], .node (.vertex 8 2) [.node (.vertex 8 3) [.node (.vertex 8 7) [.closed 5]]]]]]]]

theorem enum_ok : checkTree (pkg.spec (pkg.enumClosed 8 words)) [] enumTree = true := by
  tree_decide

/-- The initial facts of the word `words[i]`. -/
def leafFacts (i : ℕ) : List Fact := (wordFacts 8 8 (words.getD i [])).map Sum.inl

/-- The certificate of the word `[4, 3, 2, 1, 1, 6, 6, 5]` (46 terms). -/
noncomputable def tree0 : Cover.Tree Split :=
  .cert (term_rows% "../../../data/nine/six_side_two_top/w0.txt")

theorem ok0 : checkTree (pkg.spec Pkg.noClosed) (leafFacts 0) tree0 = true := by
  tree_decide

/-- The certificate of the word `[4, 3, 2, 2, 1, 5, 6, 5]` (50 terms). -/
noncomputable def tree1 : Cover.Tree Split :=
