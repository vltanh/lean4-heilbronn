/-! ### The certificate hypotheses at area `7/128` -/

/-- At least area `7/128`: a positively oriented triangle of the nine points has doubled area at
least `7/64`. -/
theorem le_sarea_of_min {a b c d e f g h : ℝ} {O : Point}
    (hm : 7 / 128 ≤ minTriangleArea (eightConfig a b c d e f g h O)) (i j k : Fin 9)
    (h0 : 0 ≤ sarea (eightConfig a b c d e f g h O i) (eightConfig a b c d e f g h O j)
      (eightConfig a b c d e f g h O k))
    (hij : i ≠ j := by decide) (hjk : j ≠ k := by decide) (hik : i ≠ k := by decide) :
    7 / 64 ≤ sarea (eightConfig a b c d e f g h O i) (eightConfig a b c d e f g h O j)
      (eightConfig a b c d e f g h O k) := by
  have := two_mul_le_sarea_of_nonneg (by norm_num : (0 : ℝ) < 7 / 128) h0
    (area_of_le_min hm i j k hij hjk hik)
  linarith

/-- At least area `7/128`: the common certificate hypotheses (`CertModel.Base`: budgets and the
gap bounds of Lemma 7) and the overlaps of Lemma 10. -/
theorem base_of_min {a b c d e f g h x y : ℝ} (hA : EightAnchors a b c d e f g h)
    (hO : InOpenSquare (x, y))
    (hm : 7 / 128 ≤ minTriangleArea (eightConfig a b c d e f g h (x, y))) :
    CertModel.Base a b c d e f g h x y ∧ g < c ∧ b < f ∧ a < e ∧ d < h := by
  have hmo := hm.trans (min_le_oct a b c d e f g h (x, y))
  obtain ⟨b1, b2, b3, b4, b5, b6, b7, b8⟩ := budgets hA (by norm_num) hmo
  have h7 := lemma7 hA
  have h10 := (lemma10 hA).1
  have hLm : h - a ≤ maxGap a b c d e f g h := le_trans (le_max_left _ _) (le_max_left _ _)
  have hBm : c - b ≤ maxGap a b c d e f g h := le_trans (le_max_right _ _) (le_max_left _ _)
  have hRm : e - d ≤ maxGap a b c d e f g h := le_trans (le_max_left _ _) (le_max_right _ _)
  have hTm : f - g ≤ maxGap a b c d e f g h := le_trans (le_max_right _ _) (le_max_right _ _)
  have hm16 : maxGap a b c d e f g h ≤ 11 / 16 := by
    by_contra hc
    push Not at hc
    nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ maxGap a b c d e f g h - 11 / 16)
      (by linarith : (0 : ℝ) ≤ maxGap a b c d e f g h - 5 / 16)]
  have hr2 := sqrt_two_gt
  have hsmall : (3 - 2 * Real.sqrt 2) / 4 < 7 / 128 := by linarith
  obtain ⟨hx0, hx1, hy0, hy1⟩ := hO
  refine ⟨⟨hA, hx0, hx1, hy0, hy1, by linarith, by linarith, by linarith, by linarith, by linarith,
    by linarith, by linarith, by linarith, by linarith, by linarith, by linarith, by linarith⟩,
    ?_, ?_, ?_, ?_⟩ <;> by_contra hc <;> push Not at hc
  · linarith [h10 (Or.inr (Or.inl hc))]
  · linarith [h10 (Or.inl hc)]
  · linarith [h10 (Or.inr (Or.inr (Or.inr hc)))]
  · linarith [h10 (Or.inr (Or.inr (Or.inl hc)))]

/-! ### §9. A single corner cap beside a double wedge -/

/-- **Theorem 11** (`EIGHT_BOUNDARY:Theorem11`). In the normal form, if `O` lies in the central
region (11), in the closed triangles `ADE` and `HDE`, in the closed corner cap `conv(B,C,D,E)`,
and outside the closed corner cap `conv(D,E,F,G)`, the minimum triangle area is strictly less than
`7/128 < A₀`.
`hand/EIGHT_BOUNDARY.md`, lines 664–829.
Uses: EIGHT_BOUNDARY:Lemma7, EIGHT_BOUNDARY:Lemma10. -/
theorem theorem11 {a b c d e f g h : ℝ} {O : Point} (hA : EightAnchors a b c d e f g h)
    (hO : InOpenSquare O) (hc : InCentralRegion (octagon a b c d e f g h) O)
    (hADE : InClosedPolygon ![(0, a), (1, d), (1, e)] O)
    (hHDE : InClosedPolygon ![(0, h), (1, d), (1, e)] O)
    (hBCDE : InClosedPolygon ![(b, 0), (c, 0), (1, d), (1, e)] O)
    (hDEFG : ¬ InClosedPolygon ![(1, d), (1, e), (f, 1), (g, 1)] O) :
    minTriangleArea (eightConfig a b c d e f g h O) < 7 / 128 := by
  by_contra hcon
  push Not at hcon
  obtain ⟨x, y⟩ := O
  obtain ⟨H, hcg, hbf, -, -⟩ := base_of_min hA hO hcon
  have hA' := hA
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12⟩ := hA'
  obtain ⟨hx0, hx1, hy0, hy1⟩ := hO
  simp only at hx0 hx1 hy0 hy1
  have oEB := le_sarea_of_min hcon 4 1 8 (hBCDE 3)
  have hye : y ≤ e := by
    have e0 : 0 ≤ sarea (1, e) (b, 0) (x, y) := hBCDE 3
    simp only [sarea] at e0
    by_contra hc'; push Not at hc'
    nlinarith only [e0, mul_pos (by linarith : (0 : ℝ) < 1 - b) (by linarith : 0 < y - e),
      mul_pos (by linarith : (0 : ℝ) < e) (by linarith : 0 < 1 - x)]
  have hDG : 0 ≤ sarea (1, d) (g, 1) (x, y) := by
    simp only [InClosedPolygon, not_forall, not_le] at hDEFG
    obtain ⟨i, hi⟩ := hDEFG
    fin_cases i
    · exfalso; simp [finRotate_apply, sarea] at hi; nlinarith
    · exfalso; simp [finRotate_apply, sarea] at hi
      nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ 1 - e) (by linarith : (0 : ℝ) ≤ 1 - x),
        mul_nonneg (by linarith : (0 : ℝ) ≤ 1 - f) (by linarith : (0 : ℝ) ≤ e - y)]
    · exfalso; simp [finRotate_apply, sarea] at hi; nlinarith
    · simp [finRotate_apply] at hi
      linarith [sarea_swap₁₂ (g, 1) (1, d) (x, y)]
  exact CertModel.cert11 H (le_sarea_of_min hcon 7 3 8 (hHDE 0))
    (le_sarea_of_min hcon 4 0 8 (hADE 2)) oEB (le_sarea_of_min hcon 2 3 8 (hBCDE 1))
    (le_sarea_of_min hcon 2 5 8 (hc.2 1).le) (le_sarea_of_min hcon 3 6 8 hDG)
    (le_sarea_of_min hcon 0 3 8 (hc.1 0).le) (le_sarea_of_min hcon 4 7 8 (hc.1 2).le)
    (le_sarea_of_min hcon 6 1 8 (hc.2 3).le)
    (le_sarea_of_min hcon 1 2 8 (by
      show 0 ≤ sarea (b, 0) (c, 0) (x, y); simp only [sarea]; nlinarith))
    (le_sarea_of_min hcon 5 6 8 (by
      show 0 ≤ sarea (f, 1) (g, 1) (x, y); simp only [sarea]; nlinarith)) hcg.le hbf.le

/-! ### §10. The double wedge with no neighbouring corner cap -/

/-- **Theorem 12** (`EIGHT_BOUNDARY:Theorem12`). In the normal form, if `O` lies in the central
region (11), in the closed triangles `ADE`, `HDE`, `BCF` and `CFG`, and outside both closed corner
caps `conv(B,C,D,E)` and `conv(D,E,F,G)`, the minimum triangle area is strictly less than
`7/128 < A₀`.
`hand/EIGHT_BOUNDARY.md`, lines 833–1003.
Uses: EIGHT_BOUNDARY:Lemma7. -/
theorem theorem12 {a b c d e f g h : ℝ} {O : Point} (hA : EightAnchors a b c d e f g h)
    (hO : InOpenSquare O) (hc : InCentralRegion (octagon a b c d e f g h) O)
    (hADE : InClosedPolygon ![(0, a), (1, d), (1, e)] O)
    (hHDE : InClosedPolygon ![(0, h), (1, d), (1, e)] O)
    (hBCF : InClosedPolygon ![(b, 0), (c, 0), (f, 1)] O)
    (hCFG : InClosedPolygon ![(c, 0), (f, 1), (g, 1)] O)
    (hBCDE : ¬ InClosedPolygon ![(b, 0), (c, 0), (1, d), (1, e)] O)
    (hDEFG : ¬ InClosedPolygon ![(1, d), (1, e), (f, 1), (g, 1)] O) :
    minTriangleArea (eightConfig a b c d e f g h O) < 7 / 128 := by
  by_contra hcon
  push Not at hcon
  obtain ⟨x, y⟩ := O
  obtain ⟨H, hcg, hbf, hae, hdh⟩ := base_of_min hA hO hcon
  have hA' := hA
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12⟩ := hA'
  obtain ⟨hx0, hx1, hy0, hy1⟩ := hO
  simp only at hx0 hx1 hy0 hy1
  have hAD : 0 < sarea (0, a) (1, d) (x, y) := hc.1 0
  have hEH : 0 < sarea (1, e) (0, h) (x, y) := hc.1 2
  simp only [sarea] at hAD hEH
  have hBE : 0 ≤ sarea (b, 0) (1, e) (x, y) := by
    simp only [InClosedPolygon, not_forall, not_le] at hBCDE
    obtain ⟨i, hi⟩ := hBCDE
    fin_cases i
    · exfalso; simp [finRotate_apply, sarea] at hi; nlinarith
    · exfalso; simp [finRotate_apply, sarea] at hi
      nlinarith [mul_pos (by linarith : (0 : ℝ) < 1 - c) hAD,
        mul_nonneg (add_nonneg (mul_nonneg (by linarith : (0 : ℝ) ≤ c) (by linarith : (0 : ℝ) ≤ d))
            (mul_nonneg (by linarith : (0 : ℝ) ≤ 1 - c) (by linarith : (0 : ℝ) ≤ a)) :
            (0 : ℝ) ≤ c * d + (1 - c) * a)
          (by linarith : (0 : ℝ) ≤ 1 - x)]
    · exfalso; simp [finRotate_apply, sarea] at hi; nlinarith
    · simp [finRotate_apply] at hi
      linarith [sarea_swap₁₂ (1, e) (b, 0) (x, y)]
  have hDG : 0 ≤ sarea (1, d) (g, 1) (x, y) := by
    simp only [InClosedPolygon, not_forall, not_le] at hDEFG
    obtain ⟨i, hi⟩ := hDEFG
    fin_cases i
    · exfalso; simp [finRotate_apply, sarea] at hi; nlinarith
    · exfalso; simp [finRotate_apply, sarea] at hi
      nlinarith [mul_pos (by linarith : (0 : ℝ) < 1 - f) hEH,
        mul_nonneg (by linarith : (0 : ℝ) ≤ 1 - x)
          (by nlinarith : (0 : ℝ) ≤ (1 - f) * (1 - h) + f * (1 - e))]
    · exfalso; simp [finRotate_apply, sarea] at hi; nlinarith
    · simp [finRotate_apply] at hi
      linarith [sarea_swap₁₂ (g, 1) (1, d) (x, y)]
  exact CertModel.cert12 H (le_sarea_of_min hcon 0 3 8 (hc.1 0).le)
    (le_sarea_of_min hcon 4 7 8 (hc.1 2).le) (le_sarea_of_min hcon 2 5 8 (hc.2 1).le)
    (le_sarea_of_min hcon 6 1 8 (hc.2 3).le) (le_sarea_of_min hcon 4 0 8 (hADE 2))
    (le_sarea_of_min hcon 7 3 8 (hHDE 0)) (le_sarea_of_min hcon 5 1 8 (hBCF 2))
    (le_sarea_of_min hcon 6 2 8 (hCFG 2)) (le_sarea_of_min hcon 1 4 8 hBE)
    (le_sarea_of_min hcon 3 6 8 hDG)
    (le_sarea_of_min hcon 1 2 8 (by
      show 0 ≤ sarea (b, 0) (c, 0) (x, y); simp only [sarea]; nlinarith))
    (le_sarea_of_min hcon 5 6 8 (by
      show 0 ≤ sarea (f, 1) (g, 1) (x, y); simp only [sarea]; nlinarith))
    (le_sarea_of_min hcon 3 4 8 (by
      show 0 ≤ sarea (1, d) (1, e) (x, y); simp only [sarea]; nlinarith))
    (le_sarea_of_min hcon 7 0 8 (by
      show 0 ≤ sarea (0, h) (0, a) (x, y); simp only [sarea]; nlinarith))
    hcg.le hbf.le hae.le hdh.le

